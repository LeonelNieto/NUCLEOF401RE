{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make-clean",
            "type": "shell",
            "command": "make clean",
            "group": "build"
        },
        {
            "label": "make-all",
            "dependsOrder": "sequence",
            "dependsOn": [
                "make-clean"
            ],
            "type": "shell",
            "command": "make",
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: arm-none-eabi-gcc compilar archivo activo",
            "command": "/opt/homebrew/bin/arm-none-eabi-gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarea generada por el depurador."
        }
    ]
}